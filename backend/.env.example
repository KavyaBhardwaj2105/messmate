# ---------------------------------------------------------
# MessMate Backend — Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file to version control.
# ---------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/messmate
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/messmate
# Required in production. If unset in development, the app falls back
# to a local JSON file store purely for demo/portfolio convenience.
MONGO_URI=mongodb://127.0.0.1:27017/messmate

# JWT signing secret. MUST be a long, random, unique string in every
# environment — never reuse the example below.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_characters

# Comma-separated list of allowed frontend origins for CORS.
# Required in production. Example for multiple origins:
# CLIENT_URL=https://messmate.vercel.app,https://www.messmate.com
CLIENT_URL=http://localhost:5173

# Production auth/session
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
COOKIE_DOMAIN=

# Email (Resend HTTP API)
RESEND_API_KEY=
MAIL_FROM=MessMate <noreply@example.com>

# Public backend URL
PUBLIC_API_URL=http://localhost:5000

# Optional production object storage (recommended)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
